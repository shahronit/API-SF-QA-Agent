# ─────────────────────────────────────────────────────────────────────────────
# Salesforce API QA Platform — environment configuration
# Copy to `.env` (never commit .env). Secrets live ONLY here or in your secret
# manager / CI secret store. The UI and API never return these values.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=4317
# Keep 127.0.0.1 unless the app sits behind an authenticated reverse proxy (SSO).
HOST=127.0.0.1
DATA_DIR=./data
# Display name used in execution logs when no X-Forwarded-User header is present.
APP_USER=qa.engineer
# Seed demo projects/data on first start (true/false). Off by default — an empty workspace.
SEED_DEMO=false

# ── Salesforce credentials ───────────────────────────────────────────────────
# Primary path: Connections → Salesforce → Log in (opens the org URL in a browser
# via `sf org login web`, or Account Manager / Business Manager for SFCC).
# Tokens stay in Salesforce CLI. The connected-app variables below are optional.
# Each project can also reference a credential prefix (e.g. ACME_QA). Supported
# flows: client_credentials | jwt | refresh_token
SF_ACME_QA_AUTH_FLOW=client_credentials
SF_ACME_QA_LOGIN_URL=https://your-domain--qa.sandbox.my.salesforce.com
SF_ACME_QA_CLIENT_ID=
SF_ACME_QA_CLIENT_SECRET=
# JWT bearer flow (alternative):
# SF_ACME_QA_USERNAME=integration.user@example.com.qa
# SF_ACME_QA_PRIVATE_KEY_PATH=./secrets/acme_qa_server.key
# Refresh-token flow (alternative):
# SF_ACME_QA_REFRESH_TOKEN=

# Optional low-privilege user for authorization / FLS / record-level tests.
# Same keys with _LOWPRIV_ inserted, e.g.:
# SF_ACME_QA_LOWPRIV_AUTH_FLOW=jwt
# SF_ACME_QA_LOWPRIV_CLIENT_ID=
# SF_ACME_QA_LOWPRIV_USERNAME=readonly.user@example.com.qa
# SF_ACME_QA_LOWPRIV_PRIVATE_KEY_PATH=./secrets/acme_qa_server.key
# SF_ACME_QA_LOWPRIV_LOGIN_URL=https://test.salesforce.com

# ── Jira Cloud ───────────────────────────────────────────────────────────────
# Per-project prefix (JIRA_<PREFIX>_*) or global fallback (JIRA_*).
JIRA_EMAIL=
JIRA_API_TOKEN=
# Field id holding sprint information in your Jira site.
JIRA_SPRINT_FIELD=customfield_10020
# Issue link type used when linking a defect to its story.
JIRA_LINK_TYPE=Relates
# Issue type used for defects.
JIRA_DEFECT_ISSUE_TYPE=Bug

# ── Salesforce MCP (optional — live describe/SOQL without using REST for metadata)
# HTTP Streamable MCP, or a stdio command. Org OAuth is still required to *run* tests.
# SF_ACME_QA_MCP_URL=http://127.0.0.1:7443/mcp
# SF_ACME_QA_MCP_COMMAND=npx -y @salesforce/mcp

# ── Salesforce B2C Commerce Cloud (OCAPI / SCAPI / SLAS) ────────────────────
# Prefix from Connections → Commerce Cloud (e.g. GLOBEX_CC).
# SFCC_GLOBEX_CC_CLIENT_ID=
# SFCC_GLOBEX_CC_CLIENT_SECRET=

# ── Postman MCP (API testing layer — collection discovery, reuse, execution)
# Approve upserts the collection; Run executes it with runCollection when MCP is up.
# Prefer env vars — do not paste the API key into the UI except on loopback .env write.
# POSTMAN_MCP_URL=http://127.0.0.1:8765/mcp
# POSTMAN_MCP_COMMAND=npx -y @postman/postman-mcp-server
# POSTMAN_WORKSPACE=
# POSTMAN_API_KEY=
# Per-project prefix (same as Salesforce credential ref): POSTMAN_<PREFIX>_API_KEY etc.

# ── Frontend HTTP (custom REST / BFF / middleware) ───────────────────────────
# Base URL can also be set on Connections → Postman / HTTP (not a secret).
# HTTP_ACME_QA_BASE_URL=https://api.your-bff.example
# HTTP_ACME_QA_TOKEN=

# ── Salesforce CLI (browser login — preferred over connected-app secrets)
# SF_CLI_BIN=sf
# SF_TARGET_ORG=

# ── Cursor CLI (optional — generate API scripts from Jira / integration docs) ─
# Login via Connections → Connect Cursor (`agent login` / `cursor login`). No API key.
# CURSOR_CLI_BIN=agent
# CURSOR_CLI_ENABLED=false

# ── Gemini CLI (optional — same generation path if Cursor is not logged in) ──
# Login via Connections → Connect Gemini (opens `gemini`, then Sign in with Google). No API key.
# GEMINI_CLI_BIN=gemini
# GEMINI_CLI_ENABLED=false

# ── Optional AI assistance (story analysis augmentation, run summaries) ─────
# Leave blank to use the deterministic rule engine only.
ANTHROPIC_API_KEY=
AI_MODEL=
