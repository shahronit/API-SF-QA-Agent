# ─────────────────────────────────────────────────────────────────────────────
# Salesforce API QA Platform — environment configuration
# Copy to `.env` (never commit .env). Secrets live ONLY here or in your secret
# manager / CI secret store. The UI and API never return these values.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=4317
# Keep 127.0.0.1 unless the app sits behind an authenticated reverse proxy (SSO).
HOST=127.0.0.1
DATA_DIR=./data
# Display name used in execution logs when no X-Forwarded-User header is present.
APP_USER=qa.engineer
# Seed demo projects/data on first start (true/false).
SEED_DEMO=true

# ── Salesforce credentials ───────────────────────────────────────────────────
# Each project references a credential prefix (e.g. ACME_QA). The server reads
# SF_<PREFIX>_* variables. Supported flows: client_credentials | jwt | refresh_token
SF_ACME_QA_AUTH_FLOW=client_credentials
SF_ACME_QA_LOGIN_URL=https://your-domain--qa.sandbox.my.salesforce.com
SF_ACME_QA_CLIENT_ID=
SF_ACME_QA_CLIENT_SECRET=
# JWT bearer flow (alternative):
# SF_ACME_QA_USERNAME=integration.user@example.com.qa
# SF_ACME_QA_PRIVATE_KEY_PATH=./secrets/acme_qa_server.key
# Refresh-token flow (alternative):
# SF_ACME_QA_REFRESH_TOKEN=

# Optional low-privilege user for authorization / FLS / record-level tests.
# Same keys with _LOWPRIV_ inserted, e.g.:
# SF_ACME_QA_LOWPRIV_AUTH_FLOW=jwt
# SF_ACME_QA_LOWPRIV_CLIENT_ID=
# SF_ACME_QA_LOWPRIV_USERNAME=readonly.user@example.com.qa
# SF_ACME_QA_LOWPRIV_PRIVATE_KEY_PATH=./secrets/acme_qa_server.key
# SF_ACME_QA_LOWPRIV_LOGIN_URL=https://test.salesforce.com

# ── Jira Cloud ───────────────────────────────────────────────────────────────
# Per-project prefix (JIRA_<PREFIX>_*) or global fallback (JIRA_*).
JIRA_EMAIL=
JIRA_API_TOKEN=
# Field id holding sprint information in your Jira site.
JIRA_SPRINT_FIELD=customfield_10020
# Issue link type used when linking a defect to its story.
JIRA_LINK_TYPE=Relates
# Issue type used for defects.
JIRA_DEFECT_ISSUE_TYPE=Bug

# ── Optional AI assistance (story analysis augmentation, run summaries) ─────
# Leave blank to use the deterministic rule engine only.
ANTHROPIC_API_KEY=
AI_MODEL=
