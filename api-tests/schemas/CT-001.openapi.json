{
  "openapi": "3.0.3",
  "info": {
    "title": "Acme Integration APIs (Apex REST)",
    "version": "1.4.0"
  },
  "paths": {
    "/services/apexrest/v1/invoices": {
      "post": {
        "operationId": "createInvoice",
        "summary": "Create an invoice from ERP",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "409": {
            "description": "Duplicate invoice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Account not found"
          }
        }
      }
    },
    "/services/apexrest/v1/contacts/sync": {
      "post": {
        "operationId": "syncContact",
        "responses": {
          "200": {
            "description": "Upserted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "salesforceId",
                    "action"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "SUCCESS"
                      ]
                    },
                    "salesforceId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9]{18}$"
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "created",
                        "updated",
                        "duplicate-ignored"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "422": {
            "description": "Account not found"
          }
        }
      }
    },
    "/services/apexrest/v1/leads": {
      "post": {
        "operationId": "createLead",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "salesforceId"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "salesforceId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/services/apexrest/v1/erp/health": {
      "get": {
        "operationId": "erpHealth",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InvoiceRequest": {
        "type": "object",
        "required": [
          "invoiceNumber",
          "accountExternalId",
          "amount"
        ],
        "properties": {
          "invoiceNumber": {
            "type": "string",
            "maxLength": 80
          },
          "erpInvoiceId": {
            "type": "string",
            "maxLength": 40
          },
          "accountExternalId": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "INR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "Issued",
              "Paid",
              "Cancelled"
            ]
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "InvoiceResponse": {
        "type": "object",
        "required": [
          "status",
          "salesforceId",
          "invoiceNumber",
          "syncStatus"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS"
            ]
          },
          "salesforceId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9]{18}$"
          },
          "invoiceNumber": {
            "type": "string"
          },
          "syncStatus": {
            "type": "string",
            "enum": [
              "Pending",
              "Synced",
              "Failed"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "status",
          "errorCode",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ERROR"
            ]
          },
          "errorCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}